APP_NAME=MellowAura
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# X-Robots-Tag: noindex locally and on staging. Production sets false.
APP_NOINDEX=true

APP_LOCALE=pl
APP_FALLBACK_LOCALE=pl
APP_FAKER_LOCALE=pl_PL

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mellowaura
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Mails wait in the database queue for `php artisan queue:work` (a Forge background process on the server).
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Order e-mails go out from this address; replies reach contact_email from the panel settings.
MAIL_FROM_ADDRESS="kasia@mellow-aura.com"
MAIL_FROM_NAME="Kasia z MellowAury"
# Staging and production send through Postmark: MAIL_MAILER=postmark and the server's API token.
POSTMARK_API_KEY=
# Staging only: every mail goes to this inbox, with the original recipients in the subject. Alerts keep their address.
MAIL_REDIRECT_TO=

# Technical alerts (errors, a stopped queue or scheduler) for the person who looks after the shop, not for Kasia.
# Empty: alerts only reach the log. The heartbeat URL is an optional outside check pinged every minute.
MONITORING_ALERT_EMAIL=
MONITORING_HEARTBEAT_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Local development in Sail: replace the values above with these in .env
# DB_HOST=mysql
# DB_USERNAME=sail
# DB_PASSWORD=password
# MAIL_MAILER=smtp
# MAIL_HOST=mailpit
# MAIL_PORT=1025
# APP_PORT=8000
# FORWARD_DB_PORT=3307
