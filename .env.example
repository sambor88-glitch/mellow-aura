APP_NAME=MellowAura
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Staging only: every page asks for this login and password. Empty locally and in production.
STAGING_USER=mellowaura
STAGING_PASSWORD=

# X-Robots-Tag: noindex locally and on staging. Production sets false.
APP_NOINDEX=true

APP_LOCALE=pl
APP_FALLBACK_LOCALE=pl
APP_FAKER_LOCALE=pl_PL
# Languages with their own addresses. English (/en/) stays off in production until its texts are ready;
# locally and on staging: pl,en. See config/localization.php.
APP_LOCALES=pl,en

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mellowaura
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Mails wait in the database queue for `php artisan queue:work` (a Forge background process on the server).
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Order e-mails go out from this address; replies reach contact_email from the panel settings.
MAIL_FROM_ADDRESS="kasia@mellow-aura.com"
MAIL_FROM_NAME="Kasia z MellowAury"
# Staging and production send through Postmark: MAIL_MAILER=postmark and the server's API token.
POSTMARK_API_KEY=
# Staging only: every mail goes to this inbox, with the original recipients in the subject. Alerts keep their address.
MAIL_REDIRECT_TO=

# Technical alerts (errors, a stopped queue or scheduler) for the person who looks after the shop, not for Kasia.
# Empty: alerts only reach the log. The heartbeat URL is an optional outside check pinged every minute.
MONITORING_ALERT_EMAIL=
MONITORING_HEARTBEAT_URL=

# The map of InPost lockers on the checkout: the token comes from InPost Manager (Moje konto → API → Geowidget)
# and is tied to the shop's domain. Empty: no map, the customer types the locker's code or leaves it to Kasia.
# Sandbox true takes the map from InPost's test servers, for a token issued there.
INPOST_GEOWIDGET_TOKEN=
INPOST_GEOWIDGET_SANDBOX=false
# ShipX (MA-132): parcels and PDF labels from the order in the panel. Token and organization id from InPost Manager
# → Moje konto → API. Sandbox true talks to sandbox-api-shipx-pl.easypack24.net, for a sandbox account's token.
INPOST_SHIPX_TOKEN=
INPOST_SHIPX_ORGANIZATION_ID=
INPOST_SHIPX_SANDBOX=false

# Payments (Przelewy24). From the Przelewy24 panel: merchant id, point of sale id (empty = the merchant id),
# CRC key and the API (reports) key. Empty merchant id, CRC or API key mean the shop pays itself: the stand-in
# gateway walks the whole path on a laptop and on staging, and never runs in production.
# Sandbox true talks to sandbox.przelewy24.pl, for keys issued there. Notifications come to /przelewy24/powiadomienie.
PRZELEWY24_MERCHANT_ID=
PRZELEWY24_POS_ID=
PRZELEWY24_CRC=
PRZELEWY24_API_KEY=
PRZELEWY24_SANDBOX=false
# BLIK code typed in the shop needs BLIK Level 0 switched on by Przelewy24. Until then false: BLIK on their page.
PRZELEWY24_BLIK_ON_SITE=true

# Backups (MA-79): nightly archive of the database and storage/app to S3 in Frankfurt, bucket from infra/backups.
# Without BACKUP_DISK the archive stays on the server's own disk — on the server set it to `backups`.
BACKUP_DISK=local
BACKUP_ARCHIVE_PASSWORD=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_REGION=eu-central-1
BACKUP_AWS_BUCKET=
# Empty database next to the shop's, used only by the weekly restore drill (monitoring:verify-backup).
DB_RESTORE_DATABASE=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Local development in Sail: replace the values above with these in .env
# DB_HOST=mysql
# DB_USERNAME=sail
# DB_PASSWORD=password
# MAIL_MAILER=smtp
# MAIL_HOST=mailpit
# MAIL_PORT=1025
# APP_PORT=8000
# FORWARD_DB_PORT=3307
